<Project>
	<PropertyGroup>

		<LangVersion>12.0</LangVersion>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<CoreVersion>0.4.1</CoreVersion>
		<StandardVersion>0.4.1</StandardVersion>
		<AnalyzerVersion>0.4.2</AnalyzerVersion>
		<CoreReleaseNotes>Interaction Flow Architecture の基盤 API を更新したリリースです。</CoreReleaseNotes>
		<StandardReleaseNotes>Interaction Flow Architecture の標準 API と標準実装を更新したリリースです。</StandardReleaseNotes>
		<AnalyzerReleaseNotes>Interaction Flow Architecture の依存関係ルールを検証する Analyzer を更新したリリースです。</AnalyzerReleaseNotes>
		
		<Title>$(AssemblyName)</Title>
		<Authors>StudioIdGames</Authors>
		<Company>StudioIdGames</Company>
		<DescriptionHead>このプロジェクトは、Interaction Flow Architecture を C# で実現するためのベースライブラリです。</DescriptionHead>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/Studio-id-Game/InteractionFlowArchitecture</PackageProjectUrl>
		<PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
		<RepositoryType>git</RepositoryType>
		<RepositoryUrl>https://github.com/Studio-id-Game/InteractionFlowArchitecture</RepositoryUrl>
		<PackageTags>interaction-flow;interaction-flow-architecture;csharp;dotnet;netstandard</PackageTags>

		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\NUGET_README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<PackageId>InteractionFlow.Core</PackageId>
		<VersionPrefix>$(CoreVersion)</VersionPrefix>
		<Description>$(DescriptionHead)特に、基盤となる仕組みを提供するコアライブラリを提供します。</Description>
		<PackageTags>$(PackageTags);core;flow;architecture</PackageTags>
		<PackageReleaseNotes>$(CoreReleaseNotes)</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\InteractionFlow.Analyzers\InteractionFlow.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>

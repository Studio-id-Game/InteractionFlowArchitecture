<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>netstandard2.1</TargetFramework>
		<PackageId>InteractionFlow.Standard</PackageId>
		<VersionPrefix>$(StandardVersion)</VersionPrefix>
		<Description>$(DescriptionHead)特に、基本的なAPIを提供するスタンダードライブラリを提供します。</Description>
		<PackageTags>$(PackageTags);standard;console;dependency-injection</PackageTags>
		<PackageReleaseNotes>Interaction Flow Architecture の標準 API と標準実装を提供する 0.4.0 リリースです。</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
		<ProjectReference Include="..\InteractionFlow.Core\InteractionFlow.Core.csproj" />
		<ProjectReference Include="..\InteractionFlow.Analyzers\InteractionFlow.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
	</ItemGroup>
</Project>
